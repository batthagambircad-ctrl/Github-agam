name: Multi Platform Testing

on:
  pull_request:
    branches:
      - main

jobs:
  ubuntu-job:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Display OS Information
        run: |
          echo "Running on Ubuntu"
          uname -a

      - name: Create and Display File
        run: |
          echo "Hello from Ubuntu" > ubuntu.txt
          cat ubuntu.txt

  windows-job:
    runs-on: windows-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Display OS Information
        run: |
          echo "Running on Windows"
          systeminfo

      - name: Create and Display File
        run: |
          echo Hello from Windows > windows.txt
          type windows.txt

  macos-job:
    runs-on: macos-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Display OS Information
        run: |
          echo "Running on macOS"
          uname -a

      - name: Create and Display File
        run: |
          echo "Hello from macOS" > macos.txt
          cat macos.txt
